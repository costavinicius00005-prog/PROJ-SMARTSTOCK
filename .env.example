# Copie para .env e preencha. O arquivo .env nao deve ser versionado.

# Banco de dados PostgreSQL (servico "db" do docker-compose)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_NAME=smartstock

# OBRIGATORIO: segredo que assina os tokens de sessao (HMAC-SHA256), minimo de 32 caracteres.
# A API nao sobe sem ele. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Primeiro administrador (so usado quando o banco nao tem nenhum usuario).
# Sem ADMIN_PASSWORD, uma senha aleatoria e gerada e exibida uma unica vez no log da API.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=8+ caracteres com letras e numeros

# Sessao: expiracao absoluta (horas) e por inatividade (minutos)
# SESSION_MAX_HOURS=12
# SESSION_IDLE_MINUTES=120

# Limite de tentativas de login (por usuario; por IP e 4x este valor)
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15

# Retencao LGPD (dias / anos)
# GPS_RETENTION_DAYS=30
# SESSION_RETENTION_DAYS=90
# AUDIT_RETENTION_DAYS=365
# CLIENT_LEGAL_RETENTION_YEARS=5

# Origens de navegador que podem chamar a API diretamente (versao web do app do entregador).
# Padrao: localhost:3000 e dominios ngrok/trycloudflare. Nunca use "*".
# CORS_ALLOWED_ORIGINS=https://seu-endereco.ngrok-free.dev

# Porta da API: 127.0.0.1 (padrao) = so este computador; 0.0.0.0 = rede local (teste do app sem tunel)
# API_BIND=127.0.0.1

# Cookie de sessao "Secure": automatico (liga quando o acesso chega por HTTPS). Force com true/false.
# COOKIE_SECURE=true

# Politica de privacidade (pagina /privacidade)
# PRIVACY_CONTROLLER_NAME=Razao social da loja
# PRIVACY_CONTROLLER_CNPJ=00.000.000/0001-00
# PRIVACY_DPO_NAME=Nome do encarregado
# PRIVACY_DPO_EMAIL=privacidade@sualoja.com.br

# APP_TIMEZONE=America/Sao_Paulo
